# ローカル開発用（秘密情報ではない）。cp .env.example .env.local
API_ORIGIN=http://127.0.0.1:8081
NEXT_PUBLIC_USE_EMULATORS=1
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-t167

# Googleドライブ実接続：実Google認証と同じプロジェクトの公開設定を使う。
# 模擬ログイン環境では実OAuthは使えない。詳細 docs/drive-local-testing.md。
# NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
# NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=

# 実Google認証・Firestoreをローカルから使う場合だけ、FirebaseコンソールのWeb設定を指定する。
# 公開設定であり、サービスアカウントの鍵やアクセストークンは書かない。
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=devfest2026-t167
