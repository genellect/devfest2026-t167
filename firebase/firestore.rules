rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid);
    }
    function isMember(roomId) { return signedIn() && exists(memberPath(roomId)); }
    function isModerator(roomId) {
      return isMember(roomId) && get(memberPath(roomId)).data.role == 'moderator';
    }
    function phase(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.phase;
    }

    // 部屋・参加者・結果はメンバーだけが読める。書き込みはすべて API（Admin SDK）経由
    match /rooms/{roomId} {
      allow read: if isMember(roomId);
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(roomId);
        allow write: if false;
      }

      // 非公開の事前意見：本人だけが読み書きできる（司会者も読めない）
      match /privateOpinions/{uid} {
        allow read: if isMember(roomId) && request.auth.uid == uid;
        allow create, update: if isMember(roomId) && request.auth.uid == uid
          && phase(roomId) == 'collecting'
          && request.resource.data.keys().hasOnly(['text', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // 議論中の発言：メンバーが自分名義でだけ投稿できる。編集・削除は不可
      match /messages/{messageId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && phase(roomId) == 'discussing'
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // AI の介入提案：司会者はすべて、参加者は承認済みだけ読める
      match /insights/{insightId} {
        allow read: if isModerator(roomId)
          || (isMember(roomId) && resource.data.status == 'approved');
        allow write: if false;
      }

      // 合意内容の一文：本人だけが読み書きできる。ずれの分析結果は results に API が書く
      match /consensusStatements/{uid} {
        allow read: if isMember(roomId) && request.auth.uid == uid;
        allow create, update: if isMember(roomId) && request.auth.uid == uid
          && phase(roomId) == 'consensus'
          && request.resource.data.keys().hasOnly(['text', 'agreement', 'concern', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.agreement is int
          && request.resource.data.agreement >= 1
          && request.resource.data.agreement <= 5
          && (!('concern' in request.resource.data)
              || (request.resource.data.concern is string
                  && request.resource.data.concern.size() <= 300))
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // 結果（チームドキュメント「タブ 14」：メンバー向けの結果は参加したグループの分だけ、先生は自分の部屋のすべて）。
      // グループの結果（group-{番号}・flow-g{番号}）は、そのグループのメンバーと先生だけが読める。グループを選んでいない生徒は読めない
      // （グループが1つの部屋では、参加のときに API が group: 1 を書く）。クラス全体の結果（summary・coverage）は先生だけが読む
      match /results/{resultId} {
        allow read: if isModerator(roomId)
          || (isMember(roomId) && resultId.matches('^(group-|flow-g)[0-9]+$')
              && int(resultId.replace('^(group-|flow-g)', '')) == get(memberPath(roomId)).data.get('group', 0));
        allow write: if false;
      }
    }
    // 上に書いていないパス（参加コード joinCodes など）は、クライアントから一切アクセスできない
  }
}
